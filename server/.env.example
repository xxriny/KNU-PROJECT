# ── 서버 기본 설정 ───────────────────────────────────────────
ENV=dev
HOST=0.0.0.0
PORT=8001

# shared.db 절대 경로 (기본값: 이 파일과 같은 디렉터리)
# SHARED_DB_PATH=/data/shared.db

# ── JWT ─────────────────────────────────────────────────────
# 반드시 변경 (openssl rand -hex 32)
JWT_SECRET=navigator-server-dev-secret-change-in-prod

# ── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,app://.

# ── GitHub OAuth (Device Flow) ───────────────────────────────
GITHUB_CLIENT_ID=Ov23liGtoHmNR9pdMmkJ
# GITHUB_CLIENT_SECRET=  # Device Flow는 불필요

# ── Gemini API (서버 전역 키) ────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# Google Vertex AI (USE_VERTEX_AI=true 이면 우선 사용)
USE_VERTEX_AI=false
GCP_PROJECT_ID=your_project_id
GCP_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Stripe 빌링 ──────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
