# Google Gemini API Key
# https://aistudio.google.com/app/apikey 에서 발급
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Vertex AI 설정 (USE_VERTEX_AI=true 이면 우선 사용됨)
USE_VERTEX_AI=true
GCP_PROJECT_ID=your_project_id
GCP_LOCATION=us-central1
# 서비스 계정 키 (JSON) 파일 경로 (gcloud auth를 쓰지 않고 직접 명시할 경우 주석 해제)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-file.json

OPENAI_API_KEY=your_openai_api_key_here

# 실행 환경 (dev / prod)
ENV=dev
NAVIGATOR_GITHUB_CLIENT_ID=Ov23liGtoHmNR9pdMmkJ

# ── 공유 DB 경로 ───────────────────────────────────────────────
# 기본값: ./server/shared.db (NAVIGATOR/server/shared.db)
# 배포 환경에서는 server가 공유하는 DB 파일의 절대 경로를 지정하세요.
# NAVIGATOR_SHARED_DB_PATH=/data/shared.db

# ── NAVIGATOR Server 연동 ──────────────────────────────────────
# 배포된 NAVIGATOR Server의 URL (billing, gemini key proxy 등)
# NAVIGATOR_SERVER_URL=https://your-navigator-server.example.com

# ── JWT 시크릿 ─────────────────────────────────────────────────
# NAVIGATOR-SERVER의 JWT_SECRET과 동일한 값을 사용해야 토큰 공유 가능
# NAVIGATOR_JWT_SECRET=navigator-dev-secret-change-in-production
